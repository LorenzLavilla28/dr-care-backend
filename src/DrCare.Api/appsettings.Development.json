{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=drcare;Username=drcare;Password=change-me"
  },
  "Jwt": {
    "Issuer": "dr-care-api",
    "Audience": "dr-care-frontend",
    "SigningKey": "local-development-only-key-change-before-sharing",
    "AccessTokenMinutes": 15
  },
  "Storage": {
    "Provider": "Local",
    "Local": {
      "BaseUrl": "http://localhost:8080",
      "RootPath": "local-storage",
      "Secret": "local-development-storage-secret-change-me"
    }
  },
  "Email": {
    "Enabled": false,
    "TenantId": "",
    "ClientId": "",
    "ClientSecret": "",
    "FromAddress": "",
    "FromName": "Dr. Care Medical Group",
    "FrontendBaseUrl": "http://localhost:5173",
    "SigningReminderHoursBeforeExpiry": 24,
    "Digests": { "Enabled": true, "HourLocal": 8, "MinimumUnread": 1 },
    "Queue": {
      "PollIntervalSeconds": 5,
      "BatchSize": 10,
      "MaxAttempts": 5,
      "BaseRetrySeconds": 30,
      "ProcessingTimeoutMinutes": 10,
      "MaxTotalAttachmentBytes": 2500000
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "DevelopmentOrganizationId": "00000000-0000-0000-0000-000000000001"
